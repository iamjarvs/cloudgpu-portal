# Copy to .env and fill in before first boot.
# These only seed the customer/operator logins on first run — change them later
# from the /ops settings page without needing to redeploy.

CUSTOMER_USERNAME=hackmecorp
CUSTOMER_PASSWORD=change-me

OPERATOR_USERNAME=adam
OPERATOR_PASSWORD=change-me

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Signs the customer session cookie. Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

PORT=8000
DB_PATH=data/portal.db
